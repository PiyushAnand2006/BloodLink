# ---------------------------------------------------------------
# BloodLink client configuration — copy to .env.local and fill in.
# ---------------------------------------------------------------

# Express API base URL (must match the server's CORS CLIENT_URL origin).
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Google OAuth 2.0 client ID (same client as the server's GOOGLE_CLIENT_ID).
# Leave unset to hide the Google button (dev login panel still works).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Set to "true" to show the developer login panel on /login with the
# seeded demo accounts (server must run in development mode).
NEXT_PUBLIC_DEV_LOGIN=true
