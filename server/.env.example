# ---------------------------------------------------------------
# BloodLink server configuration — copy to .env and fill in values.
# Never commit a real .env file (it is gitignored).
# ---------------------------------------------------------------

# ---- Server (Express) ----
PORT=4000
NODE_ENV=development

# ---- Database (PostgreSQL, used by Prisma) ----
# Option A (zero-install): run `npm run db:start` — it boots a project-local
#   PostgreSQL on port 5433 and prints the exact URL to paste here.
# Option B: your own PostgreSQL or Docker instance.
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>?schema=public

# ---- Auth ----
# Generate a strong secret, e.g.: openssl rand -hex 48
JWT_SECRET=<paste-a-long-random-secret-here>
JWT_EXPIRES_IN=7d
# Google OAuth 2.0 "Web application" client ID (same client for server + client).
GOOGLE_CLIENT_ID=<your-google-oauth-client-id>.apps.googleusercontent.com
# Demo password given to all seeded accounts (dev seeding only — never use in production).
SEED_DEMO_PASSWORD=<min-8-chars-demo-password>

# ---- CORS ----
# Exact origin of the Next.js app (credentials are only allowed from here).
CLIENT_URL=http://localhost:3000

# ---- Client (Next.js) public env — must be prefixed with NEXT_PUBLIC_ ----
NEXT_PUBLIC_GOOGLE_CLIENT_ID=<your-google-oauth-client-id>.apps.googleusercontent.com
NEXT_PUBLIC_API_URL=http://localhost:4000/api
